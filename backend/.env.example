# AI Workforce backend configuration
# Copy this file to .env and provide unique secret values.

# Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_workforce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Leave blank to derive the URL from the PostgreSQL fields above.
DATABASE_URL=

# Authentication
SECRET_KEY=
SEED_DEFAULT_PASSWORD=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0
WORK_QUEUE_NAME=ai-workforce:jobs
WORK_QUEUE_PROCESSING_NAME=ai-workforce:jobs:processing
WORK_QUEUE_DEAD_LETTER_NAME=ai-workforce:jobs:dead-letter
WORKER_HEARTBEAT_KEY=ai-workforce:worker:heartbeat

# Email delivery. Keep "outbox" for safe local development; use "smtp" only
# with secret values supplied by the deployment environment.
EMAIL_DELIVERY_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# MinIO / object storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# CORS
FRONTEND_URL=http://localhost:3000
