APP_ENV=development
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8100
AI_SERVICE_INTERNAL_TOKEN=

EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_VERSION=qwen3-embedding-v1
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DEVICE=cuda
EMBEDDING_DTYPE=float16
EMBEDDING_CACHE_FOLDER=.cache/huggingface
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_MAX_RETRIES=3

RERANK_BACKEND=bge
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cuda
RERANK_DTYPE=float16
RERANK_CACHE_FOLDER=.cache/huggingface
RERANK_LOCAL_FILES_ONLY=false
RERANK_BATCH_SIZE=2
RERANK_MAX_LENGTH=2048
RERANK_CANDIDATE_LIMIT=30
RERANK_MIN_MODEL_SCORE=0.15
RERANK_MODEL_WEIGHT=0.90
RERANK_FALLBACK_ENABLED=true
RERANK_INSTRUCTION=Truy xuất đoạn tài liệu nội bộ chính xác và đủ căn cứ để trả lời câu hỏi.

OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
